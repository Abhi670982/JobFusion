####################################
# Database & Prisma
####################################
# Supabase / PostgreSQL transaction pooler connection URL (for PgBouncer pooling in serverless)
DATABASE_URL="postgresql://postgres:your_password@db.your_supabase_project.supabase.co:6543/postgres?pgbouncer=true"

# Direct PostgreSQL connection URL for Prisma migrations (session-mode, bypasses pooler)
DIRECT_URL="postgresql://postgres:your_password@db.your_supabase_project.supabase.co:5432/postgres"

####################################
# Supabase
####################################
# Base REST API URL of your Supabase instance (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your_supabase_project.supabase.co/rest/v1/"

# Supabase Anonymous Publishable Key (safe to expose on client-side)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"

# Supabase Service Role Secret Key (keep secure, never expose on client-side)
SUPABASE_SECRET_KEY="your_supabase_secret_key"

####################################
# Clerk Authentication
####################################
# Clerk publishable key from Dashboard (e.g. pk_test_...)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"

# Clerk Secret Key from Dashboard (e.g. sk_test_...)
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"

# Routing paths for custom Clerk auth flows
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

####################################
# Cloudinary Asset Storage
####################################
# Cloudinary account cloud name (Dashboard)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"

# Cloudinary access API key
CLOUDINARY_API_KEY="your_cloudinary_api_key"

# Cloudinary access API secret (keep hidden)
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

####################################
# Progressive Sync Cutoffs
####################################
# Minimum number of unique matched jobs required during a progressive crawl before early stopping (Default: 20)
MIN_RELEVANT_JOB_TARGET="20"
