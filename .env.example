####################################
# Database & Prisma
####################################
# PostgreSQL / Supabase connection pooling URL (e.g. PgBouncer / Transaction pooler on port 6543)
DATABASE_URL="postgresql://postgres:your_password@db.your_supabase_project.supabase.co:6543/postgres?pgbooster=true"

# Direct PostgreSQL connection URL (Required by Prisma for database migrations e.g. port 5432)
DIRECT_URL="postgresql://postgres:your_password@db.your_supabase_project.supabase.co:5432/postgres"

####################################
# Clerk Authentication
####################################
# Clerk Publishable Key (From Clerk Dashboard -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"

# Clerk Secret Key (Never expose on client-side)
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"

# Clerk Authentication Routing Conventions
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

####################################
# Cloudinary Asset Storage
####################################
# Cloudinary cloud name for profile avatars and resume storage
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"

# Cloudinary API key
CLOUDINARY_API_KEY="your_cloudinary_api_key"

# Cloudinary API secret key
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

####################################
# AI Providers (Google Gemini)
####################################
# Google Gemini AI API key for resume parsing and match scoring
GEMINI_API_KEY="your_google_gemini_api_key"
GOOGLE_GENERATIVE_AI_API_KEY="your_google_gemini_api_key"

####################################
# Cron & Background Jobs
####################################
# Secret key for securing automated Vercel Cron endpoints (/api/cron/crawl)
CRON_SECRET="your_cron_secret_token"

# Redis server connection string (Used by BullMQ job queue)
REDIS_URL="redis://localhost:6379"

####################################
# Job Scraping & Aggregator Services
####################################
# Python / Node Job Aggregator Service API URL
JOB_AGGREGATOR_URL="http://localhost:5000"

# Default keywords for job scraping (Comma-separated)
FETCH_KEYWORDS="software engineer,frontend developer,backend developer,fullstack developer"

# SerpAPI Key for Google / Indeed job indexing
SERPAPI_KEY="your_serpapi_key"

# RapidAPI Key for LinkedIn job feeds
RAPIDAPI_KEY="your_rapidapi_key"

# Wellfound (AngelList) Session Cookie Token
WELLFOUND_SESSION_TOKEN="your_wellfound_session_token"

####################################
# Email Notification System (SMTP)
####################################
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_gmail_app_password"
SMTP_FROM_EMAIL="noreply@jobfusion.ai"

####################################
# Application & Server Setup
####################################
# Public base URL of the JobFusion web application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node environment mode (development | production | test)
NODE_ENV="development"

####################################
# Future Payment Gateway
####################################
# Razorpay Integration Credentials
RAZORPAY_KEY_ID="rzp_test_your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# Stripe Integration Credentials
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
