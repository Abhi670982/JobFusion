####################################
# Database & Prisma
####################################
# Supabase / PostgreSQL transaction pooler connection URL
DATABASE_URL="postgresql://postgres:your_password@db.your_supabase_project.supabase.co:6543/postgres?pgbouncer=true"

# Direct PostgreSQL connection URL for Prisma migrations
DIRECT_URL="postgresql://postgres:your_password@db.your_supabase_project.supabase.co:5432/postgres"


####################################
# Clerk Authentication
####################################
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

####################################
# Cloudinary Asset Storage
####################################
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

####################################
# Gemini AI
####################################
GEMINI_API_KEY="your_google_gemini_api_key"
GOOGLE_GENERATIVE_AI_API_KEY="your_google_gemini_api_key"

####################################
# Cron & Background Jobs
####################################
CRON_SECRET="your_cron_secret_token"
REDIS_URL="redis://localhost:6379"

####################################
# Job Scraping & Aggregator
####################################
JOB_AGGREGATOR_URL="http://localhost:5000"
FETCH_KEYWORDS="software engineer,frontend developer,backend developer"
SERPAPI_KEY="your_serpapi_key"
RAPIDAPI_KEY="your_rapidapi_key"
WELLFOUND_SESSION_TOKEN="your_wellfound_session_token"

####################################
# Email System (SMTP)
####################################
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_gmail_app_password"
SMTP_FROM_EMAIL="noreply@jobfusion.ai"

####################################
# Dodo Payments
####################################
DODO_API_KEY="dp_test_your_dodo_payments_api_key"
DODO_MONTHLY_PRODUCT_ID="pdt_your_monthly_product_id"
DODO_YEARLY_PRODUCT_ID="pdt_your_yearly_product_id"

