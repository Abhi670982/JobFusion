####################################
# Database & Prisma
####################################
# Supabase / PostgreSQL transaction pooler connection URL (for PgBouncer pooling in serverless)
DATABASE_URL="postgresql://postgres:your_password@db.your_supabase_project.supabase.co:6543/postgres?pgbouncer=true"

# Direct PostgreSQL connection URL for Prisma migrations (session-mode, bypasses pooler)
DIRECT_URL="postgresql://postgres:your_password@db.your_supabase_project.supabase.co:5432/postgres"

####################################
# Clerk Authentication
####################################
# Clerk publishable key from Dashboard (e.g. pk_test_...)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"

# Clerk Secret Key from Dashboard (e.g. sk_test_...)
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"

# Routing paths for custom Clerk auth flows
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

####################################
# Cloudinary Asset Storage
####################################
# Cloudinary account cloud name (Dashboard)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"

# Cloudinary access API key
CLOUDINARY_API_KEY="your_cloudinary_api_key"

# Cloudinary access API secret (keep hidden)
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

####################################
# AI Providers (BYOK Encryption)
####################################
ENCRYPTION_KEY="your_32_byte_hex_encryption_key_here"

GEMINI_API_KEY="your_google_gemini_api_key"
GOOGLE_GENERATIVE_AI_API_KEY="your_google_gemini_api_key"
OPENAI_API_KEY="your_openai_api_key"
ANTHROPIC_API_KEY="your_anthropic_api_key"

####################################
# Cron & Background Jobs
####################################
CRON_SECRET="your_cron_secret_token"
REDIS_URL="redis://localhost:6379"

####################################
# Job Scraping & Aggregator
####################################
JOB_AGGREGATOR_URL="http://localhost:5000"
FETCH_KEYWORDS="software engineer,frontend developer,backend developer"
SERPAPI_KEY="your_serpapi_key"
RAPIDAPI_KEY="your_rapidapi_key"
WELLFOUND_SESSION_TOKEN="your_wellfound_session_token"

# Minimum number of unique matched jobs required during a progressive crawl before early stopping (Default: 20)
MIN_RELEVANT_JOB_TARGET="20"

####################################
# Email System (SMTP)
####################################
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_gmail_app_password"
SMTP_FROM_EMAIL="noreply@jobfusion.ai"

####################################
# Dodo Payments
####################################
DODO_API_KEY="dp_test_your_dodo_payments_api_key"
DODO_MONTHLY_PRODUCT_ID="pdt_your_monthly_product_id"
DODO_YEARLY_PRODUCT_ID="pdt_your_yearly_product_id"
