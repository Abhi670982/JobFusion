####################################
# Database & Prisma
####################################
# Supabase / PostgreSQL transaction pooler connection URL (for PgBouncer pooling in serverless)
DATABASE_URL="postgresql://postgres:your_password@your_supabase_host:6543/postgres?pgbouncer=true"

# Direct PostgreSQL connection URL for Prisma migrations (session-mode, bypasses pooler)
DIRECT_URL="postgresql://postgres:your_password@your_supabase_host:5432/postgres"

####################################
# Redis & Background Crawler Queue
####################################
# Upstash or local Redis URL for BullMQ job queue and background crawling
REDIS_URL="rediss://default:your_redis_password@your_redis_host:6379"

####################################
# Cloudinary Asset Storage
####################################
# Cloudinary account cloud name
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"

# Cloudinary access API key
CLOUDINARY_API_KEY="your_cloudinary_api_key"

# Cloudinary access API secret (keep hidden)
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

####################################
# Clerk Authentication
####################################
# Clerk publishable key from Dashboard (e.g. pk_test_...)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"

# Clerk Secret Key from Dashboard (e.g. sk_test_...)
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"

# Routing paths for Clerk auth flows
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

####################################
# Supabase
####################################
# Base REST API URL of your Supabase instance
NEXT_PUBLIC_SUPABASE_URL="https://your_supabase_project.supabase.co/rest/v1/"

# Supabase Anonymous Publishable Key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"

# Supabase Service Role Secret Key (keep hidden)
SUPABASE_SECRET_KEY="your_supabase_secret_key"

####################################
# AI Providers (Optional / Fallback)
####################################
# Gemini API Key (Google Generative AI)
GEMINI_API_KEY="your_gemini_api_key"

# OpenAI API Key
OPENAI_API_KEY="your_openai_api_key"

# Anthropic API Key
ANTHROPIC_API_KEY="your_anthropic_api_key"

####################################
# Security & Encryption (Optional)
####################################
# Key used to encrypt user API keys in the database
API_KEY_ENCRYPTION_KEY="your_secure_random_encryption_key"

# Cron trigger secret key
CRON_SECRET="your_cron_secret"

####################################
# Payments (Dodo Payments - Optional)
####################################
DODO_API_KEY="your_dodo_api_key"
DODO_PAYMENTS_WEBHOOK_KEY="your_dodo_webhook_key"
DODO_MONTHLY_PRODUCT_ID="p_your_monthly_product_id"
DODO_YEARLY_PRODUCT_ID="p_your_yearly_product_id"

####################################
# External Search / Scraping APIs (Optional)
####################################
# RapidAPI Key (LinkedIn scraper)
RAPIDAPI_KEY="your_rapidapi_key"

# SerpAPI Key (Google / Indeed jobs search)
SERPAPI_KEY="your_serpapi_key"

# Wellfound session token
WELLFOUND_SESSION_TOKEN="your_wellfound_session_token"

####################################
# Progressive Sync Cutoffs & Config
####################################
# Target count for progressive crawl early stopping
MIN_RELEVANT_JOB_TARGET="20"
